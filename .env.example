# Required — 64 hex chars for AES-256-GCM credential encryption
NAGADB_SECRET_KEY=

# Edition: community (self-hosted, no billing) or cloud
NAGADB_EDITION=community

# Bootstrap a platform admin on first boot
NAGADB_ADMIN_EMAIL=
NAGADB_ADMIN_PASSWORD=

# KHQR checkout (optional)
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_NAME=NAGADB
BAKONG_TOKEN=
BAKONG_ACCOUNT_TYPE=individual

# Backup offload command (optional) — {file} is substituted with the dump path
# BACKUP_OFFLOAD_CMD=rclone copy {file} r2:nagadb-backups

LOG_LEVEL=info
